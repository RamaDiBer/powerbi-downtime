	partition Downtime = m
		mode: import
		source = ```
				let
				  Origen = SharePoint.Files("https://mirgor.sharepoint.com/sites/Soporte-adm", [ApiVersion = 15]),
				    #"Filas filtradas" = Table.SelectRows(Origen, each ([Extension] = ".xlsx") and ([Name] = "Downtime no manufactura.xlsx")),
				    #"Downtime no manufactura xlsx_https://mirgor sharepoint com/sites/Soporte-adm/Shared Documents/Soporte plantas continente/5 - General plantas/2- Downtime/" = #"Filas filtradas"{[Name="Downtime no manufactura.xlsx",#"Folder Path"="https://mirgor.sharepoint.com/sites/Soporte-adm/Shared Documents/Soporte plantas continente/5 - General plantas/2- Downtime/"]}[Content],
				    #"Libro de Excel importado" = Excel.Workbook(#"Downtime no manufactura xlsx_https://mirgor sharepoint com/sites/Soporte-adm/Shared Documents/Soporte plantas continente/5 - General plantas/2- Downtime/"),
				    Downtime_Sheet = #"Libro de Excel importado"{[Item="Downtime",Kind="Sheet"]}[Data],
				    #"Encabezados promovidos" = Table.PromoteHeaders(Downtime_Sheet, [PromoteAllScalars=true]),
				    #"Tipo cambiado" = Table.TransformColumnTypes(#"Encabezados promovidos",{{"Fecha", type date}, {"Week", Int64.Type}, {"Detalle", type text}, {"Comentario", type text}, {"Downtime PP", type datetime}, {"Downtime", type datetime}, {"Motivo", type text}, {"Sitio", type text}, {"Turno", type text}, {"Tecnico", type text}, {"Unidad de Negocio", type text}, {"Downtime HS", type datetime}, {"Ticket", type text}}),
				    #"Filas en blanco eliminadas" = Table.SelectRows(#"Tipo cambiado", each not List.IsEmpty(List.RemoveMatchingItems(Record.FieldValues(_), {"", null}))),
				    #"Personalizada agregada" = Table.AddColumn(#"Filas en blanco eliminadas", "Personalizado", each if [Downtime HS] = null
				then null 
				else Time.Hour(Time.From([Downtime HS])) * 60 + Time.Minute(Time.From([Downtime HS]))),
				    #"Columnas con nombre cambiado" = Table.RenameColumns(#"Personalizada agregada",{{"Personalizado", "DowntimeHS"}}),
				    #"Personalizada agregada1" = Table.AddColumn(#"Columnas con nombre cambiado", "Personalizado", each if [Downtime PP] = null
				then null 
				else Time.Hour(Time.From([Downtime PP])) * 60 + Time.Minute(Time.From([Downtime PP]))),
				    #"Columnas con nombre cambiado1" = Table.RenameColumns(#"Personalizada agregada1",{{"Personalizado", "DowntimePP"}}),
				    #"Personalizada agregada2" = Table.AddColumn(#"Columnas con nombre cambiado1", "Personalizado", each if [Downtime] = null
				then null 
				else Time.Hour(Time.From([Downtime])) * 60 + Time.Minute(Time.From([Downtime]))),
				    #"Tipo cambiado1" = Table.TransformColumnTypes(#"Personalizada agregada2",{{"Personalizado", type number}}),
				    #"Columnas con nombre cambiado2" = Table.RenameColumns(#"Tipo cambiado1",{{"Personalizado", "Downtime (min)"}, {"DowntimePP", "Downtime PP (min)"}, {"DowntimeHS", "Downtime HS (min)"}}),
				    #"Tipo cambiado2" = Table.TransformColumnTypes(#"Columnas con nombre cambiado2",{{"Downtime PP (min)", type number}, {"Downtime HS (min)", type number}}),
				    #"Columnas reordenadas" = Table.ReorderColumns(#"Tipo cambiado2",{"Fecha", "Week", "Detalle", "Comentario", "Downtime PP", "Downtime", "Motivo", "Sitio", "Turno", "Tecnico", "Unidad de Negocio", "Downtime HS", "Ticket", "Downtime PP (min)", "Downtime (min)", "Downtime HS (min)"}),
				    #"Filas filtradas1" = Table.SelectRows(#"Columnas reordenadas", each ([Week] <> 0)),
				    #"Tipo cambiado3" = Table.TransformColumnTypes(#"Filas filtradas1",{{"Downtime", Int64.Type}, {"Downtime PP", Int64.Type}})
				in
				    #"Tipo cambiado3"
				```

